PORT=3001
DATABASE_URL="postgresql://postgres@localhost:5432/equli?schema=public"
DATABASE_PASS="replace-with-your-postgres-password"
JWT_SECRET="super-secret-jwt-key-replace-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-key-replace-in-production"
GOOGLE_CLIENT_ID="google-client-id"
GOOGLE_CLIENT_SECRET="google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
FRONTEND_URL="http://localhost:3000"

# Seed manual de demostración: NO ejecutar contra datos reales.
ALLOW_DEMO_SEED=false
# Opcionales; sin ambos valores no se crea ningún administrador.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
